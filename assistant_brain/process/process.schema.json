{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainclaw.local/schemas/process.schema.json",
  "title": "BrainClaw Process Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "effective",
    "geo",
    "status",
    "keywords"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "effective": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "geo": {
      "type": "string",
      "enum": [
        "China",
        "Global",
        "Philippines"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}

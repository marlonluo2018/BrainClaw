{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainclaw.local/schemas/task-file.schema.json",
  "title": "BrainClaw Active Task File",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "filename_task_id", "title", "status", "created", "priority",
    "category", "geo", "due", "epd", "scope", "exclude", "sections", "tags"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "filename_task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "title": {"$ref": "#/$defs/one_line"},
    "status": {"$ref": "#/$defs/one_line"},
    "created": {"$ref": "#/$defs/one_line"},
    "priority": {"type": "string", "pattern": "^P[1-3]$"},
    "category": {"$ref": "#/$defs/one_line"},
    "geo": {"$ref": "#/$defs/one_line"},
    "due": {"$ref": "#/$defs/one_line"},
    "epd": {"$ref": "#/$defs/one_line"},
    "scope": {
      "allOf": [
        {"$ref": "#/$defs/one_line"},
        {"not": {"pattern": "^(?:—|-|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Nn]/?[Aa]|[Nn][Oo][Nn][Ee]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])$"}}
      ]
    },
    "exclude": {"$ref": "#/$defs/one_line"},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contacts", "stakeholders", "raci", "tags", "asks", "my_actions",
        "waiting_on_others", "timeline", "current_state", "notes"
      ],
      "properties": {
        "contacts": {"const": true},
        "stakeholders": {"const": true},
        "raci": {"const": true},
        "tags": {"const": true},
        "asks": {"const": true},
        "my_actions": {"const": true},
        "waiting_on_others": {"const": true},
        "timeline": {"const": true},
        "current_state": {"const": true},
        "notes": {"const": true}
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/one_line"}
    }
  },
  "$defs": {
    "one_line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    }
  }
}

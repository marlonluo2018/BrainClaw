# Codebuddy folder
.codebuddy/

# Skills directory - contains separate projects
assistant_brain/skills/*

# Logs directory - ignore all logs except current.md
assistant_brain/logs/*
!assistant_brain/logs/current.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
~$*

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Backups folder - keep backups locally only
assistant_brain/backups/
backups/

# Downloads folder - email attachments, etc.
downloads/
outbox/

# Memory directory - keep files locally but don't sync to GitHub
assistant_brain/memory/

# Process content remains local/private; the machine-readable schema is versioned
assistant_brain/process/*
!assistant_brain/process/process.schema.json

# Task content is private; the reusable format contract is version-controlled.
assistant_brain/tasks/*
!assistant_brain/tasks/FORMATS.md

# Sync results - runtime artifacts, keep local only
assistant_brain/sync_results/

# One-time local scripts (root only)
/adhoc/

# assistant_brain/scripts is private by default. Only reviewed, reusable,
# task-data-free runtime and quality tooling is allowlisted for the main repository.
assistant_brain/scripts/*
!assistant_brain/scripts/README.md
!assistant_brain/scripts/check_links.py
!assistant_brain/scripts/dashboard.py
!assistant_brain/scripts/doctor.py

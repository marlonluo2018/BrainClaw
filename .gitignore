!assistant_brain/scripts/email_sync_apply.py
!assistant_brain/scripts/followup.py
!assistant_brain/scripts/generate_prompts.py
!assistant_brain/scripts/manage_ignore_candidates.py
!assistant_brain/scripts/ooxml_workbook.py
!assistant_brain/scripts/run_email_sync.py
!assistant_brain/scripts/shared_config.py
!assistant_brain/scripts/update_task.py
!assistant_brain/scripts/validate_processes.py
!assistant_brain/scripts/validate_tasks.py

